# Скопируй этот файл в .env и заполни своими значениями. .env никогда не коммитить в git.

# Логин и пароль от АДМИН-ПАНЕЛИ. Их знаешь только ты — они живут только тут,
# на сервере, и никогда не попадают ни в один файл фронтенда или в базу.
ADMIN_USERNAME=change_me
ADMIN_PASSWORD=change_me_too_1234

# Случайная длинная строка для подписи JWT-сессий админки. Сгенерировать можно так:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Порт, на котором поднимается сервер (хостинги обычно сами подставляют свой через PORT)
PORT=3000

NODE_ENV=production

AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
